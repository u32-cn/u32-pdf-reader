{
  "name": "u32-pdf-reader",
  "version": "0.2.0",
  "description": "简洁 PDF 阅读器：批注 + 内嵌音频播放",
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:main": "node esbuild-main.mjs",
    "build": "npm run build:main && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "node scripts/dist-app.mjs",
    "pack": "node scripts/dist-app.mjs --dir"
  },
  "author": "vtxf",
  "license": "MIT",
  "devDependencies": {
    "@vtxfp/vtxf-basic-tools-202607": "^1.0.0",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "cn.u32.pdfreader",
    "productName": "u32-pdf-reader",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-setup.${ext}",
      "publish": null,
      "icon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "U32 PDF 阅读器",
        "description": "用 U32 PDF 阅读器打开",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "u32 PDF 阅读器",
      "publish": null
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtxf/u32-pdf-reader.git"
  },
  "homepage": "https://u32.cn/m/u32-pdf-reader/",
  "bugs": {
    "url": "https://github.com/vtxf/u32-pdf-reader/issues"
  }
}
